{
  "name": "inkparcel",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm build:web && concurrently -k \"vite build --watch\" \"wrangler dev\"",
    "build:web": "vite build",
    "build": "pnpm build:web && wrangler deploy --dry-run",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/check-doc-links.mjs",
    "test": "pnpm -r test",
    "test:apk": "tsx scripts/verify-apks.ts",
    "test:e2e": "playwright test",
    "fixtures": "python3 scripts/generate-apk-fixtures.py",
    "setup:local": "node scripts/init-local.mjs",
    "check": "pnpm format:check && pnpm docs:check && pnpm typecheck && pnpm test && pnpm build",
    "db:migrate": "wrangler d1 migrations apply inkparcel --local",
    "deploy": "pnpm build:web && wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
